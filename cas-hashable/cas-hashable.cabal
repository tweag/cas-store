cabal-version: 1.12

name:           cas-hashable
version:        1.0.2
synopsis:       A hashing class for content-addressed storage
description:    A hashing class for content-addressed storage. Content can be hashed either by value or through an IO action. Part of the funflow ecosystem.
category:       Control
homepage:       https://github.com/tweag/cas-store#readme
bug-reports:    https://github.com/tweag/cas-store/issues
author:         Tom Nielsen, Nicholas Clarke, Andreas Herrmann
maintainer:     Matthias Meschede <matthias.meschede@tweag.io>
license:        MIT
license-file:   LICENSE
build-type:     Simple
tested-with:    GHC==9.14.1, GHC==9.12.4, GHC==9.10.3, GHC==9.8.4, GHC==9.6.7
extra-source-files:
    changelog.md

source-repository head
  type: git
  location: https://github.com/tweag/cas-store
    subdir: cas-hashable

library
  exposed-modules:
      Data.CAS.ContentHashable
  other-modules:
      Paths_cas_hashable
  hs-source-dirs:
      src
  ghc-options: -Wall
  build-depends:
      aeson >=2.1.0 && <2.3
    , base >=4.9 && <5
    , bytestring
    , containers
    , cryptonite
    , ghc-prim
    , hashable >=1.4.1 && <1.6
    , integer-gmp
    , memory
    , path
    , path-io
    , safe-exceptions
    , scientific
    , text >=2.0.1 && <2.2
    , time
    , unix
    , unordered-containers
    , vector
  default-language: Haskell2010

test-suite perf
  main-is: Main.hs
  other-modules:
      Paths_cas_hashable
  ghc-options: -Wall -rtsopts -O2
  hs-source-dirs:
      app
  build-depends:
     base >=4.6 && <5
    , cas-hashable
  default-language: Haskell2010
  type: exitcode-stdio-1.0
